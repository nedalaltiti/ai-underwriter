# configs/production.env - Production environment configuration
# Core Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# AWS Configuration
AWS_REGION=us-west-1
AWS_ENDPOINT_URL=  # Empty for production

# Queue Configuration
CONTRACT_DOWNLOAD_QUEUE=contract-download-queue-prod
DOCUMENT_PARSE_QUEUE=document-parse-queue-prod
VALIDATION_COMPLETE_QUEUE=validation-complete-queue-prod

# S3 Configuration
S3_BUCKET_NAME=forth-contracts-prod

# Database
DATABASE_URL=postgresql://forth_user:${DB_PASSWORD}@forth-contracts-prod.cluster-xxxx.us-west-1.rds.amazonaws.com:5432/forth_contracts

# External APIs
FORTH_API_BASE_URL=https://api.forth.com/v1
FORTH_API_KEY=${FORTH_API_KEY}

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4-turbo-preview

# Service-specific settings
WEBHOOK_RATE_LIMIT_ENABLED=true
WEBHOOK_RATE_LIMIT_REQUESTS=1000
WEBHOOK_RATE_LIMIT_PERIOD=60

DOCUMENT_WORKER_CONCURRENCY=20
DOCUMENT_DOWNLOAD_TIMEOUT=120

PARSER_WORKER_CONCURRENCY=10
PARSER_EXTRACTION_CONFIDENCE_THRESHOLD=0.8
PARSER_MAX_RETRIES=3

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
OTLP_ENDPOINT=http://otel-collector:4317

# Alerts
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
PAGERDUTY_INTEGRATION_KEY=${PAGERDUTY_INTEGRATION_KEY}