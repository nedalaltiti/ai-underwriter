# services/document-parser/env.prod.example
# Production environment configuration for document-parser service
# Copy this file to .env and update with your actual values

# Core service configuration
PARSER_ENVIRONMENT=production
PARSER_LOG_LEVEL=INFO
PARSER_SERVICE_NAME=document-parser
PARSER_SERVICE_VERSION=1.0.0

# Server configuration
PARSER_HOST=0.0.0.0
PARSER_PORT=8003
PARSER_WORKERS=8
PARSER_MAX_REQUESTS=5000
PARSER_MAX_REQUESTS_JITTER=500
PARSER_TIMEOUT=120
PARSER_KEEPALIVE=5

# AWS Configuration
PARSER_AWS_REGION=us-west-1
# PARSER_AWS_ENDPOINT_URL=  # Leave empty for production AWS

# SQS Configuration
PARSER_INPUT_QUEUE_NAME=uw-downloaded-docs-prod-sqs.fifo
PARSER_OUTPUT_QUEUE_NAME=uw-processed-docs-prod-sqs.fifo
PARSER_SQS_WAIT_TIME=20
PARSER_SQS_MAX_MESSAGES=1

# S3 Configuration
PARSER_S3_BUCKET_NAME=contact-contracts-prod-s3-us-west-1
PARSER_S3_PREFIX=

# Database Configuration (PostgreSQL)
PARSER_DATABASE_URL=postgresql://ai_underwriting_user:HQ82j34Lsdk7H@localhost:3307/ai_underwriting
PARSER_DATABASE_POOL_SIZE=20
PARSER_DATABASE_MAX_OVERFLOW=40
PARSER_DATABASE_TIMEOUT=60
PARSER_DATABASE_RETRY_ATTEMPTS=3

# Gemini Configuration
PARSER_GEMINI_PROJECT_ID=gemini-deployment
PARSER_GEMINI_REGION=us-central1
PARSER_GEMINI_MODEL=gemini-2.0-flash
PARSER_GEMINI_TEMPERATURE=0.1
PARSER_GEMINI_TOP_K=40
PARSER_GEMINI_TOP_P=0.95
PARSER_GEMINI_MAX_TOKENS=8192
PARSER_GEMINI_TIMEOUT=300

# Gemini Service Account (JSON format as single line - REPLACE WITH ACTUAL CREDENTIALS)
PARSER_GEMINI_SERVICE_ACCOUNT={"type":"service_account","project_id":"gemini-deployment","private_key_id":"YOUR_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT@gemini-deployment.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/YOUR_SERVICE_ACCOUNT%40gemini-deployment.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Processing Configuration
PARSER_MAX_RETRIES=3
PARSER_RETRY_DELAY=120
PARSER_PROCESSING_TIMEOUT=1800
PARSER_MAX_FILE_SIZE_MB=200

# Security Configuration
PARSER_ENABLE_REQUEST_VALIDATION=true
PARSER_ENABLE_RESPONSE_VALIDATION=true
PARSER_MAX_CONCURRENT_REQUESTS=500

# Worker Configuration
PARSER_WORKER_CONCURRENCY=10
PARSER_WORKER_PREFETCH_COUNT=2
PARSER_WORKER_HEALTH_CHECK_INTERVAL=60

# Observability
PARSER_ENABLE_METRICS=true
PARSER_ENABLE_TRACING=true
PARSER_TRACE_SAMPLE_RATE=0.05
PARSER_METRICS_PORT=9090

# Production Configuration
PARSER_GRACEFUL_SHUTDOWN_TIMEOUT=60
PARSER_HEALTH_CHECK_TIMEOUT=30
PARSER_RATE_LIMIT_PER_MINUTE=5000

# AWS Credentials (use IAM roles in production when possible)
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN  # Only if using temporary credentials