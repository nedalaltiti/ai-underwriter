# services/webhook-ingestion/.env.example
# Development environment configuration for webhook-ingestion service
# Copy this file to .env and fill in your actual values

# Environment
WEBHOOK_ENVIRONMENT=development
WEBHOOK_LOG_LEVEL=INFO

# AWS Configuration
WEBHOOK_AWS_REGION=us-west-1

# Queue Configuration (FIFO queues for ordered processing)
WEBHOOK_UW_UPLOADED_DOCS_QUEUE=uw-uploaded-docs-dev-sqs.fifo
WEBHOOK_UW_UPLOADED_DOCS_DLQ=uw-uploaded-docs-dev-dlq.fifo

# Security (REQUIRED - minimum 32 characters)
WEBHOOK_SECRET=your-32-character-secret-key-here-replace-with-real-secret

# Rate Limiting
WEBHOOK_RATE_LIMIT_ENABLED=true
WEBHOOK_RATE_LIMIT_REQUESTS=100
WEBHOOK_RATE_LIMIT_PERIOD=60

# CORS Configuration
WEBHOOK_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server Configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8001

# Observability
WEBHOOK_ENABLE_METRICS=true
WEBHOOK_ENABLE_TRACING=true
WEBHOOK_TRACE_SAMPLE_RATE=0.1

# AWS Credentials (for local development)
# In production, use IAM roles or AWS credentials provider
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
