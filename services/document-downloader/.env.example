# services/document-downloader/.env.example
# Development environment configuration for document-downloader service
# Copy this file to .env and fill in your actual values

# Environment
DOCUMENT_ENVIRONMENT=development
DOCUMENT_LOG_LEVEL=INFO

# AWS Configuration
DOCUMENT_AWS_REGION=us-west-1

# Queue Configuration (FIFO queues for ordered processing)
DOCUMENT_UW_UPLOADED_DOCS_QUEUE=uw-uploaded-docs-dev-sqs.fifo
DOCUMENT_UW_DOWNLOADED_DOCS=uw-downloaded-docs-dev-sqs.fifo

# S3 Configuration
DOCUMENT_S3_BUCKET_NAME=your-s3-bucket-name

# Forth API Configuration
DOCUMENT_FORTH_API_BASE_URL=https://api.forth.com
DOCUMENT_FORTH_API_KEY=your-forth-api-key
DOCUMENT_FORTH_API_KEY_ID=your-forth-api-key-id
DOCUMENT_FORTH_API_TIMEOUT=30

# Worker Configuration
DOCUMENT_WORKER_CONCURRENCY=10
DOCUMENT_DOWNLOAD_TIMEOUT=60
DOCUMENT_TEMP_DIR=/tmp/downloads

# Retry Configuration
DOCUMENT_MAX_RETRIES=3
DOCUMENT_RETRY_DELAY=60

# Server Configuration
DOCUMENT_HOST=0.0.0.0
DOCUMENT_PORT=8002

# Observability
DOCUMENT_ENABLE_METRICS=true
DOCUMENT_ENABLE_TRACING=true

# AWS Credentials (for local development)
# In production, use IAM roles or AWS credentials provider
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
