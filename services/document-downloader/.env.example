# services/document-downloader/.env.example
# Service Configuration
DOCUMENT_ENVIRONMENT=development
DOCUMENT_LOG_LEVEL=INFO
DOCUMENT_HOST=0.0.0.0
DOCUMENT_PORT=8002

# AWS Configuration
DOCUMENT_AWS_REGION=us-west-1
DOCUMENT_AWS_ACCESS_KEY_ID=your-access-key
DOCUMENT_AWS_SECRET_ACCESS_KEY=your-secret-key

# Queue Configuration
DOCUMENT_INPUT_QUEUE_NAME=contract-download-queue
DOCUMENT_OUTPUT_QUEUE_NAME=document-parse-queue

# S3 Configuration
DOCUMENT_S3_BUCKET_NAME=forth-contracts
DOCUMENT_S3_PREFIX=contracts

# Forth API Configuration
DOCUMENT_FORTH_API_BASE_URL=https://api.forth.com/v1
DOCUMENT_FORTH_API_KEY=your-forth-api-key
DOCUMENT_FORTH_API_TIMEOUT=30

# Worker Configuration
DOCUMENT_WORKER_CONCURRENCY=10
DOCUMENT_DOWNLOAD_TIMEOUT=60
DOCUMENT_TEMP_DIR=/tmp/downloads

# Retry Configuration
DOCUMENT_MAX_RETRIES=3
DOCUMENT_RETRY_DELAY=60